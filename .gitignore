# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# service account key files (*.json blocked except essential config files)
*.json
!vercel.json
!package.json
!package-lock.json
!tsconfig.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# 예시 파일은 값이 비어 있으므로 커밋 허용 (.env* 규칙보다 뒤에 있어야 함)
!.env.example
